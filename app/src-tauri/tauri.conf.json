{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "taskapp",
  "version": "0.1.0",
  "identifier": "app.taskapp.desktop",
  "build": {
    "frontendDist": "../../ui/dist",
    "devUrl": "http://localhost:5173"
  },
  "app": {
    "windows": [{ "title": "taskapp", "width": 1280, "height": 800 }],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "externalBin": ["binaries/reminders-helper"],
    "icon": ["icons/icon.png"],
    "macOS": { "minimumSystemVersion": "14.0" }
  },
  "plugins": {
    "deep-link": { "desktop": { "schemes": ["taskapp"] } }
  }
}
